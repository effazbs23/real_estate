<templates xml:space="preserve">
    <t t-name="awesome_clicker.client_action">
        Clicker Game
        <div class="border p-2 m-2">
            Clicks :<ClickValue />
            <button class="btn btn-primary m-2" t-on-click="() => clicker.increment(1)">
                Increment
            </button>

            <t t-if="clicker.level >= 1">
                ClickBots : <t t-esc="clicker.clickBots"/>
            </t>

            <t t-if="clicker.level >= 4" class="m-2 p-2">
                Trees
                <t t-foreach="clicker.trees" t-as="tree" t-key="tree">
                    <div class="m-2 p-2 border card">
                        <p><t t-esc="tree_value.number"/>x <t t-esc="tree"/>Tree (1x <t t-esc="tree"/>/30seconds) </p>
                        <button class="btn btn-primary" t-on-click="() => clicker.buyTree(tree)">
                            Buy <t t-esc="tree"/>(<t t-esc="tree_value.price"/> clicks)
                        </button>

                    </div>
                </t>
                Fruits
                <t t-foreach="clicker.fruits" t-as="fruit" t-key="fruit">
                    <div class="border m-2 p-2 card">
                        <p>
                            <t t-esc="fruit_value"/>x <t t-esc="fruit"/>
                        </p>
                    </div>
                </t>
            </t>

            <t t-if="clicker.clicks >= 1000">
                <p>0x clickbot (10 clicks/10 seconds)</p>
                <button class="btn btn-primary m-2" t-on-click="() => clicker.buyClickBot()">
                    Buy ClickBot (1000 clicks)
                </button>
            </t>

            <t t-if="clicker.clicks >= 5000">
                <p>2x bigbot (100 clicks/10 seconds)</p>
                <button class="btn btn-primary m-2" t-on-click="() => clicker.buyBigBot()">
                    Buy ClickBot (5000 clicks)
                </button>
            </t>

            <t t-if="clicker.clicks >= 100000">
                <p>nx Power Clicks </p>
                <button class="btn btn-primary m-2" t-on-click="() => clicker.buyPowerClicks()">
                    Buy PowerClicks
                </button>
            </t>




        </div>
    </t>
</templates>