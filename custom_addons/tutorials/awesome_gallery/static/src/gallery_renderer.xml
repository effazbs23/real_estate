<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_gallery.GalleryRenderer">
        <div class="o_gallery_view">
            <t t-foreach="props.images" t-as="image" t-key="image.id">
                <div class="o_gallery_item">
                    <span>ID: <t t-esc="image.id"/></span> |
                    <span>Size: <t t-esc="image[props.archInfo.imageField]"/></span>
                </div>
            </t>
        </div>
    </t>
</templates>
