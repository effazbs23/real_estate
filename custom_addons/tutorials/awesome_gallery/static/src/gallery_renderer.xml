<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_gallery.GalleryRenderer">
        <div class="o_gallery_view">
            <t t-foreach="props.images" t-as="image" t-key="image.id">
                <div class="o_gallery_item">
                    <t t-if="image[props.archInfo.imageField]">
                        <img t-att-src="imageUrl(image)" alt="Image"/>
                    </t>
                    <t t-else="">
                        <div class="o_gallery_empty">No Image</div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
