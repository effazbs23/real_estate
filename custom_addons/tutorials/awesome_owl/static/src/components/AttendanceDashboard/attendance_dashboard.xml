<templates xml:space="preserve">
    <t t-name="awesome_owl.attendanceDashboard">
        <div class="border p-2 m-2 ">
            <input type="text"
                   class=""
                   placeholder="Search"
                   t-att-value="data.searchQuery"
                   t-on-input="onSearchInput"
            />
        </div>

        <div class="m-3 p-2 border">
            <table class="table">
                <thead class="table-dark">
                    <tr>
                        <th>Employee</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Worked Hours</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="filteredData" t-as="row" t-key="row.id">
                        <tr>
                            <td><t t-esc="row.name"/></td>
                            <td><t t-esc="row.check_in"/></td>
                            <td><t t-esc="row.check_out"/></td>
                            <td><t t-esc="row.hours"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>