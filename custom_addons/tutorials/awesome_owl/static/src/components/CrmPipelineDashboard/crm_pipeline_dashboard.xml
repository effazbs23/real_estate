<templates xml:space="preserve">
    <t t-name="awesome_owl.crm_pipeline_dashboard">
        <div class="p-2 m-2">
            <div class="border">
                <input type="text" placeholder="Search..." t-on-input="onSearchInput" t-att-value="data.searchQuery"/>
            </div>
            <div>
                <select t-on-change="onStageChange">
                    <t t-foreach="stages" t-as="stage" t-key="stage">
                        <option t-att-value="stage" t-att-selected="stage === data.stageQuery">
                            <t t-esc="stage"/>
                        </option>
                    </t>
                </select>
            </div>
            <div class="border">
                <table class="table">
                    <thead class="table-dark">
                        <tr>
                        <th>Lead/Opportunity</th>
                            <th>Salesperson</th>
                            <th>Stage</th>
                            <th>Value (USD)</th>
                            <th>Probability</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="filteredData" t-as="row" t-key="row.id">
                            <tr>
                                <td t-esc="row.name"/>
                                <td t-esc="row.salesperson"/>
                                <td t-esc="row.stage"/>
                                <td t-esc="row.value"/>
                                <td t-esc="row.probability"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div class="border m-2 p-2">
                <table class="table ">
                    <thead class="table-dark">
                        <th>
                            <td>KPI Card</td>
                            <td>Computation</td>
                        </th>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Total Leads</td> <td t-esc="TotalLeads"/>
                        </tr>
                        <tr>
                            <td>Pipeline Value</td> <td t-esc="PipelineValue"/>
                        </tr>
                        <tr>
                            <td>Won Revenue</td> <td t-esc="WonRevenue"/>
                        </tr>
                        <tr>
                            <td>Avg Probability</td> <td t-esc="AvgProbability"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>