<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <div>
            <input t-ref="todoInput" type="text" placeholder="Add your task" t-on-keyup="addTodo"/>
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo"/>
            </t>
        </div>
    </t>
</templates>